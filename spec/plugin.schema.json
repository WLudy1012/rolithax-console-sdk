{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rolithax Schema 1–3 plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "sdkVersion",
    "server"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]{0,63}(\\.[a-z][a-z0-9-]{0,63})+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8})){2}$"
    },
    "sdkVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "server": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "engine": {
      "enum": [
        "yaml",
        "lua"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "homepage": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mediaType",
          "size",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "video/mp4"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^assets/.+"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://"
          }
        },
        "oneOf": [
          {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          },
          {
            "required": [
              "url"
            ],
            "not": {
              "required": [
                "path"
              ]
            }
          }
        ]
      }
    },
    "actions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "operation",
              "root"
            ],
            "properties": {
              "kind": {
                "const": "file"
              },
              "operation": {
                "enum": [
                  "list",
                  "read",
                  "write",
                  "upload",
                  "download",
                  "rename",
                  "delete",
                  "mkdir"
                ]
              },
              "root": {
                "enum": [
                  "instance",
                  "mcdr-config",
                  "mcdr-plugins",
                  "minecraft"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "taskId"
            ],
            "properties": {
              "kind": {
                "const": "host-task"
              },
              "taskId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        ]
      }
    },
    "preflight": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "version"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mod",
              "minecraftPlugin",
              "mcdrPlugin"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.+-]{1,64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sdkVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "engine"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "sdkVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "engine",
          "name",
          "description",
          "authors",
          "license",
          "homepage",
          "icon",
          "assets"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "authors"
              ]
            },
            {
              "required": [
                "license"
              ]
            },
            {
              "required": [
                "homepage"
              ]
            },
            {
              "required": [
                "icon"
              ]
            },
            {
              "required": [
                "assets"
              ]
            },
            {
              "required": [
                "actions"
              ]
            },
            {
              "required": [
                "preflight"
              ]
            }
          ]
        }
      }
    }
  ]
}
